DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.lvh.me

# Supabase Postgres connection (Project Settings -> Database)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Supabase Auth (Project Settings -> API)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Subdomain suffix used for tenant resolution (org-slug.<this>).
# lvh.me resolves *.lvh.me to 127.0.0.1 with no /etc/hosts entries, and
# unlike *.localhost it can share an auth cookie across subdomains.
# In production this is your real domain.
DJANGO_BASE_DOMAIN=lvh.me

# Only needed if the frontend calls the API cross-origin; the Vite dev
# server proxies /api instead, which keeps the tenant Host header intact.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
