# Copy to .env. Never commit .env. Never put the Supabase service_role key here — the app refuses to start if it sees one.

# App connection: transaction-mode pooler as app_runtime (NOBYPASSRLS). Never the postgres role.
DATABASE_URL=postgresql://app_runtime.pooler-dev:app_runtime@127.0.0.1:55329/postgres

# Platform-admin connection: same pooler as app_platform (exempt from RLS). Used only inside withPlatformAdmin().
DATABASE_URL_PLATFORM=postgresql://app_platform.pooler-dev:app_platform@127.0.0.1:55329/postgres

# Migration runner only: direct connection as the table owner. Omit from the app's production environment.
DATABASE_URL_MIGRATOR=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Passwords the migration runner sets on the two app roles (migration 0001). Runner environment only.
APP_RUNTIME_PASSWORD=app_runtime
APP_PLATFORM_PASSWORD=app_platform

# development | test | production
NODE_ENV=development
