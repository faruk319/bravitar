# Supabase project (local: `supabase status` prints these)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Subdomain suffix org dashboards are served from (<slug>.<this>).
# lvh.me is a public domain whose wildcard DNS points at 127.0.0.1, so
# <slug>.lvh.me works with no /etc/hosts entries. *.localhost also resolves,
# but browsers treat `localhost` as a public suffix and refuse to share
# cookies across its subdomains — which breaks the shared auth session below.
VITE_BASE_DOMAIN=lvh.me

# Parent domain the auth session cookie is scoped to, so one login works
# across every org subdomain. Must be the base domain with a leading dot.
VITE_COOKIE_DOMAIN=.lvh.me
